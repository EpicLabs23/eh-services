MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=f0493877a955ec0f16d64f503b5e77f4
MONGO_PORT=27017
# Leave as 127.0.0.1 if MongoDB runs on the same host as EHM (the default -
# EHM reaches it via the eh_network bridge IP instead, not this port). If
# MongoDB runs on a separate instance, change to this host's LAN IP (or
# 0.0.0.0) so EHM can reach it over the network - see install-mongodb.md.
MONGO_BIND_ADDRESS=127.0.0.1
