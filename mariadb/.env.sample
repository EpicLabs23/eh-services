MARIADB_DATABASE=ehm
MARIADB_ROOT_PASSWORD=drootp
MARIADB_USER=ehmdbuser
MARIADB_PASSWORD=reguser
TZ=Asia/Dhaka
# Leave as 127.0.0.1 if MariaDB runs on the same host as EHM (the default -
# EHM reaches it via the eh_network bridge IP instead, not this port). If
# MariaDB runs on a separate instance, change to this host's LAN IP (or
# 0.0.0.0) so EHM can reach it over the network - see install-mariadb.md.
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_PORT=3306
