# Bootstrap superuser for pgAdmin's OWN internal login page - not used by
# any ECP account (they all arrive pre-authenticated via /ehm-signon). Only
# relevant for a staff member opening this stack's port directly, e.g. to
# check User Management for auto-created account identities.
PGADMIN_DEFAULT_EMAIL=admin@ehm.local
PGADMIN_DEFAULT_PASSWORD=

# Shared secret proving to pgAdmin that the X-Ehm-Pgadmin-User identity
# header really came from pgadmin-nginx, not a client that reached pgadmin
# directly. Generate a random value once at install time, e.g.:
#   openssl rand -hex 32
# and keep it identical on both sides - see docker-compose.yml.
PGADMIN_SHARED_SECRET=
